# 测试环境配置
# Test Environment

# API 服务器地址 - 测试服务器
#
# 🔴 2026-08-15: 原本是 http://139.196.165.140:10010 —— 实测**不可达**
# (curl POST /api/mobile/auth/unified-login → http_code=000, 8s 超时)。
# 后端直连端口被安全组挡在外面, 对外只开 nginx 网关 8086。
# 同一形状在 web-admin 的 E2E 里也有一份(那边写的是 47.100.235.168:10010),
# 症状同样是「fetch failed / SocketError」——看起来像网络抖动, 实际端点根本不通。
#
# 判据: 改这一行之前先 curl 一下, 401 才算通(证明端点在、只是凭证不对);
# 000 说明连都连不上。
REACT_APP_API_URL=http://139.196.165.140:8086

# 调试模式
REACT_APP_DEBUG=false

# 应用名称
REACT_APP_NAME=白垩纪食品溯源(测试环境)

# 测试特定配置
REACT_APP_ENV=test

# 🔴 2026-08-15: babel.config.js 读的是 process.env.ENVFILE(react-native-dotenv 在
# **编译期**按这个路径读文件), 而 env-cmd 只把本文件的键值塞进 process.env ——
# 两者原本对不上, 于是 start:test / start:production 这些脚本**从来没生效过**:
# babel 回退到 .env(仓库里根本没有这个文件) -> @env 全空 -> API 兜底到
# http://10.0.2.2:10010(Android 模拟器回环), 真机与 web 上都是死地址,
# 界面只显示一句英文 Network Error。
# 这里让本文件自己声明路径, env-cmd 加载时就把 ENVFILE 一并带进去, 零新依赖。
ENVFILE=.env.test
