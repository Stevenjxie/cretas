# 生产环境配置
# Production Environment

# API 服务器地址 - 生产服务器
# 注意: 生产地址将在部署时配置，确保与开发环境分离
REACT_APP_API_URL=https://www.cretaceousfuture.com

# 调试模式 - 生产环境必须关闭
REACT_APP_DEBUG=false

# 应用名称
REACT_APP_NAME=白垩纪食品溯源

# 生产特定配置
REACT_APP_ENV=production

# 性能和安全配置
REACT_APP_LOG_LEVEL=error
REACT_APP_ENABLE_ANALYTICS=true

# 🔴 2026-08-15: babel.config.js 读的是 process.env.ENVFILE(react-native-dotenv 在
# **编译期**按这个路径读文件), 而 env-cmd 只把本文件的键值塞进 process.env ——
# 两者原本对不上, 于是 start:test / start:production 这些脚本**从来没生效过**:
# babel 回退到 .env(仓库里根本没有这个文件) -> @env 全空 -> API 兜底到
# http://10.0.2.2:10010(Android 模拟器回环), 真机与 web 上都是死地址,
# 界面只显示一句英文 Network Error。
# 这里让本文件自己声明路径, env-cmd 加载时就把 ENVFILE 一并带进去, 零新依赖。
ENVFILE=.env.production
