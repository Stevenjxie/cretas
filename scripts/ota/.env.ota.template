# OTA server runtime config — placeholder template.
#
# The REAL .env.ota lives at /www/wwwroot/cretas/.env.ota on server 47, with
# chmod 600 root:root. NEVER commit secrets to this template; the template is
# for onboarding new operators only.
#
# Field meanings (per backend/python/ota/config.py + docs/superpowers/specs/
# 2026-05-11-self-hosted-ota-spec.md §5):

# Filesystem root the OTA module reads bundles from (storage layer appends
# /updates/<runtimeVersion>/<channel>/<timestamp>/).
OTA_BASE_PATH=/www/wwwroot/ota

# RSA-2048 PKCS#8 private-key PEM, chmod 600. Generated by Q1 openssl genrsa.
OTA_PRIVATE_KEY_PATH=/www/wwwroot/cretas/ota/ota_private.pem

# Bearer token gating /api/ota/admin/* endpoints.
# Generate with: openssl rand -hex 32
OTA_ADMIN_TOKEN=REPLACE_WITH_RANDOM_OTA_ADMIN_TOKEN

# Base URL emitted in manifest asset URLs. Phase 1-3 = IP direct HTTP; Phase 4
# onwards = https://ota.cretaceousfuture.com (independent subdomain on nginx 139,
# Let's Encrypt ECC via acme.sh DNS-01 — see spec §8). After running
# ./scripts/ota/install-nginx-ota.sh, update this line on server 47 to:
#   OTA_HOSTNAME=https://ota.cretaceousfuture.com
# and `systemctl restart cretas-python` so manifest-emitted asset URLs hit
# the public HTTPS domain (NOT the IP-direct path which is SG-blocked from
# the internet — only 139 nginx can reach 47:8083 per .claude/rules/
# aliyun-credentials.md security-group config).
OTA_HOSTNAME=http://47.100.235.168:8083

# Default channel when client omits the expo-channel-name header.
# Per Q2 resolution: only {production, staging} are valid channels.
OTA_DEFAULT_CHANNEL=production
