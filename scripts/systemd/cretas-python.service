[Unit]
Description=Cretas Python AI Service (port 8083)
After=network.target postgresql.service

[Service]
EnvironmentFile=/www/wwwroot/cretas/.env.prod
EnvironmentFile=/www/wwwroot/cretas/.env.ota
Environment=POSTGRES_DB=smartbi_prod_db
Environment=POSTGRES_ENABLED=true
Environment=POSTGRES_HOST=localhost
Environment=POSTGRES_PORT=5432
Environment=POSTGRES_USER=smartbi_user
Type=simple
User=root
WorkingDirectory=/www/wwwroot/cretas/code/backend/python
ExecStart=/www/wwwroot/cretas/code/backend/python/venv-current/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8083 --workers 2
Restart=on-failure
RestartSec=5
StandardOutput=append:/www/wwwroot/cretas/python-prod.log
StandardError=append:/www/wwwroot/cretas/python-prod.log

[Install]
WantedBy=multi-user.target
