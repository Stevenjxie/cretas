# Test Account Credentials (do NOT commit actual passwords)
# Copy this file to .env.test and fill in actual values
#
# 2026-08-07: 全部账号从 F001「测试工厂」迁到 F006「六膳门食品科技」。
# 原因: V20261029_68 把工厂域收敛成只剩 F006 + LIUSHANMEN, F001 连同它的
# factory_admin1 / workshop_sup1 / warehouse_mgr1 等账号一并物理删除, 这份模板
# 里的旧值已是死值。F006 上有一套角色完全对应的账号(f006_*), 逐个换过来即可。
#
# ⛔ F006 是**真客户租户**(305 物料 / 323 批次), 不是沙箱 —— 用这些账号跑测试时
# 只做只读, 需要写入的场景走 scripts/e2e/production-readonly 的白名单机制。

# Factory Super Admin
TEST_FACTORY_ADMIN_USER=f006_admin
TEST_FACTORY_ADMIN_PASS=<set-locally>
TEST_FACTORY_ADMIN_FACTORY_ID=F006

# Platform Admin (存在 platform_admins 表, 不属于任何工厂, 不受租户收敛影响)
TEST_PLATFORM_ADMIN_USER=platform_admin
TEST_PLATFORM_ADMIN_PASS=<set-locally>

# Workshop Supervisor
TEST_WORKSHOP_SUP_USER=f006_workshop
TEST_WORKSHOP_SUP_PASS=<set-locally>

# Warehouse Manager
TEST_WAREHOUSE_MGR_USER=f006_warehouse_mgr
TEST_WAREHOUSE_MGR_PASS=<set-locally>

# HR Admin
TEST_HR_ADMIN_USER=f006_hr_admin
TEST_HR_ADMIN_PASS=<set-locally>

# Dispatcher
TEST_DISPATCHER_USER=f006_dispatcher
TEST_DISPATCHER_PASS=<set-locally>

# Quality Inspector
TEST_QUALITY_INSP_USER=f006_quality_insp
TEST_QUALITY_INSP_PASS=<set-locally>
