<?xml version="1.0" encoding="UTF-8"?>
<!--
  cretas-logistics-app - 物流业务线的独立可部署服务。

  这是「每业务独立部署」从「量出来可行」变成「跑起来了」的那一步。它的依赖只有
  cretas-platform 与 cretas-logistics(顺带 model / common), 也就是说 cretas-api
  里那 3382 个文件一个都不需要 —— 那正是 logistics 编译期 inbound=0 的兑现。

  这个模块自己几乎没有代码: 一个 main 类和一份配置。可部署服务之间的差别本来就
  应该只有「装配了哪些域」, 而不是各自再写一遍基础设施。

  smoke profile: 只为本地冒烟启动加 H2, 证明脱离单体后 Spring 上下文仍能装配。
  它不进任何真实构建, 真实部署走 PostgreSQL。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.12</version>
        <relativePath/>
    </parent>

    <groupId>com.cretas</groupId>
    <artifactId>cretas-logistics-app</artifactId>
    <version>1.0.0</version>
    <name>Cretas Logistics Service</name>
    <description>物流业务线独立服务：platform + logistics，不含单体的其余部分</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.cretas</groupId>
            <artifactId>cretas-platform</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.cretas</groupId>
            <artifactId>cretas-logistics</artifactId>
            <version>1.0.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 真实部署用 PostgreSQL -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>cretas-logistics-service-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.cretas.aims.LogisticsServiceApplication</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- ./mvnw spring-boot:run -Psmoke -Dspring-boot.run.profiles=smoke -->
        <profile>
            <id>smoke</id>
            <dependencies>
                <dependency>
                    <groupId>com.h2database</groupId>
                    <artifactId>h2</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
