<?xml version="1.0" encoding="UTF-8"?>
<!--
  cretas-common - the platform contract layer.

  Scope rule: a class belongs here only if it is a platform contract (exception
  base, entity base, API envelope, permission annotation, cross-cutting util)
  AND is referenced by more than one business domain. Business code does not
  belong here even when several domains happen to use it; that is what the
  domain modules are for.

  Phase 0 seeds it with exactly the 8 classes the logistics module needs from
  outside itself (measured transitively, comments and string literals excluded).
  Outside consumers, i.e. why each one cannot simply move into cretas-logistics:
      annotation.RequireModule            97
      annotation.RequirePermission       many (used across all controllers)
      utils.SecurityUtils                 21
      utils.ExcelUtil                      5
      entity.BaseEntity / dto.common.ApiResponse /
      exception.BusinessException / exception.ResourceNotFoundException
                                           7-9 domains each

  Package names are unchanged (com.cretas.aims.*): only the Maven module the
  files live in changed, so not a single import in the other 3945 main sources
  had to be touched. Split packages across classpath jars are legal for javac
  and for Spring Boot's nested-jar layout (no JPMS module-info here).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.12</version>
        <relativePath/>
    </parent>

    <groupId>com.cretas</groupId>
    <artifactId>cretas-common</artifactId>
    <version>1.0.0</version>
    <name>Cretas Common - Platform Contracts</name>
    <description>平台契约层：异常基类、实体基类、API 响应封装、权限注解、跨域工具</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <lombok.version>1.18.36</lombok.version>
    </properties>

    <dependencies>
        <!-- BaseEntity: jakarta.persistence, Hibernate @SQLDelete/@Where,
             spring-data @CreatedDate/@LastModifiedDate, AuditingEntityListener -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- SecurityUtils: SecurityContextHolder, Authentication -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>

        <!-- ExcelUtil: EasyExcel writer. Same coordinates and exclusion as the
             application pom so the fat JAR keeps resolving one POI line. -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
            <version>3.3.2</version>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.poi</groupId>
                    <artifactId>poi-ooxml-schemas</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- ApiResponse: @Schema (io.swagger.v3 annotations arrive via springdoc) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.3.0</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- A release build runs `-pl cretas-api -am -Dtest=<selector>`, and
                 -Dtest applies to every module in the reactor. This module has no
                 tests, so surefire would abort the whole release with "No tests
                 matching pattern". Tolerated HERE ONLY, in plugin configuration
                 rather than via -Dsurefire.failIfNoSpecifiedTests=false on the
                 command line: the application module must keep failing when a
                 selector matches nothing, or a typo'd selector would yield an
                 artifact no test ever gated. Not skipTests either - tests added
                 to this module later must still run. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <release>21</release>
                    <encoding>UTF-8</encoding>
                    <!-- Mirrors the application: -parameters keeps reflective
                         parameter-name lookup working, and the explicit Lombok
                         processor path keeps annotation processing identical. -->
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
