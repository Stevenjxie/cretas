<?xml version="1.0" encoding="UTF-8"?>
<!--
  cretas-logistics - the first business domain extracted from the monolith.

  Why logistics went first: measured against origin/main, it is the only domain
  whose coupling to the rest of the codebase is small enough to make the split
  a mechanism test rather than a refactor. 102 files (96 under
  com.cretas.aims.logistics plus the Vehicle family, which Steve assigned to
  this domain), and:

      outbound  8 classes, all platform contracts -> cretas-common
      inbound   0 references from anywhere outside the module

  Inbound zero is the load-bearing fact: nothing in the remaining 3945 main
  sources references anything in here, so the application needs this module
  only so Spring can component-scan it and so it lands in the fat JAR - not to
  compile. That is what makes "each business line deploys on its own" reachable
  from here rather than aspirational.

  Dependencies below are the measured third-party surface of those 102 files,
  not a copy of the application's list. Package names are unchanged, so the
  module boundary cost zero import edits.

  Note: this module's Flyway migrations deliberately stay in
  cretas-api/src/main/resources/db/flyway. Splitting a single global migration
  sequence is a schema problem, not a build problem, and it is not required for
  the module boundary to hold.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.12</version>
        <relativePath/>
    </parent>

    <groupId>com.cretas</groupId>
    <artifactId>cretas-logistics</artifactId>
    <version>1.0.0</version>
    <name>Cretas Logistics Domain</name>
    <description>物流域：运单/车辆/排班/路线优化/导入导出</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <lombok.version>1.18.36</lombok.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.cretas</groupId>
            <artifactId>cretas-common</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- controller/*: org.springframework.web, org.springframework.http;
             DTO serialization: com.fasterxml.jackson -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- entity/repository/*: jakarta.persistence, org.hibernate.annotations,
             org.springframework.data, org.springframework.transaction -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- entity/*: JSONB column types on PostgreSQL (Hibernate 6.3) -->
        <dependency>
            <groupId>io.hypersistence</groupId>
            <artifactId>hypersistence-utils-hibernate-63</artifactId>
            <version>3.7.3</version>
        </dependency>

        <!-- service/routing/*: external routing/map HTTP calls -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.12.0</version>
        </dependency>

        <!-- service/importjob/*, service/export/*: EasyExcel + POI (POI arrives
             transitively through easyexcel, same as in the application pom) -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
            <version>3.3.2</version>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.poi</groupId>
                    <artifactId>poi-ooxml-schemas</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- controller/*, dto/*: io.swagger.v3 annotations -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.3.0</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <release>21</release>
                    <encoding>UTF-8</encoding>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
