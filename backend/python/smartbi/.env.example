# SmartBI Service Configuration

# LLM Configuration - Text Models
LLM_API_KEY=REPLACE_WITH_LLM_API_KEY
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-max-2026-01-23

# LLM Configuration - Vision Model (for structure detection)
LLM_VL_MODEL=qwen3-vl-plus-2025-12-19
LLM_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM Configuration - Fast Model (for quick operations)
LLM_FAST_MODEL=qwen3.5-flash

# LLM Configuration - Reasoning Model (for complex decisions)
LLM_REASONING_MODEL=qwq-32b

# Zero-Code Configuration
STRUCTURE_DETECTION_CONFIDENCE_THRESHOLD=0.7
SEMANTIC_MAPPING_CONFIDENCE_THRESHOLD=0.8
ENABLE_MULTI_MODEL_ENHANCEMENT=true
MAX_SELF_CORRECTION_ROUNDS=3

# Service Configuration
DEBUG=false
PORT=8083
HOST=0.0.0.0

# CORS Configuration (comma-separated origins)
# CORS_ORIGINS=["http://localhost:3000","http://localhost:10010"]

# File Upload Configuration
MAX_FILE_SIZE_MB=500

# Cache Configuration
CACHE_TTL_SECONDS=3600
SCHEMA_CACHE_ENABLED=true

# ──────────────────────────────────────────────────────────────────────────
# 二维火 (2dfire) POS Open API — SKELETON adapter (smartbi/ingestion/twodfire_adapter.py)
# ──────────────────────────────────────────────────────────────────────────
# NOT yet a live integration. Leave the secret triplet EMPTY until we obtain
# 二维火 开放平台 credentials — the /api/smartbi/{factory}/ingest/2dfire/sync
# endpoint then returns a fool-proof "未配置" dead-end (no fake data).
# When all three of APP_KEY / APP_SECRET / SHOP_ID are set, is_configured()
# flips True and the (future) sync path activates.
# API_BASE has a sensible default; override only if 二维火 changes the host.
TWODFIRE_API_BASE=https://open.2dfire.com
TWODFIRE_APP_KEY=
TWODFIRE_APP_SECRET=
TWODFIRE_SHOP_ID=
